# Allowlist: ignore everything, then opt in. Secrets live in .env (never committed).
/*
!/.gitignore
!/.gitmodules
!/README.md
!/SETUP.md
!/.github/
!/openclaw.json
!/workspace/
/workspace/*
!/workspace/*.md
# nothing is tracked here (private skills live in workspace/private/skills), but un-ignored so claw-sync
# removes any skill planted here
!/workspace/skills/
# the install's private repo (SOUL.md, IDENTITY.md, AGENTS.md, skills/): a pinned submodule
!/workspace/private
# the reader agent's workspace: only its rules are tracked (it has no memory)
!/workspace-reader/
/workspace-reader/*
!/workspace-reader/AGENTS.md
# public skills (see AGENTS.md "Skills: private by default"), and the private repo's template
!/skills/
!/private.example/

# agent-owned state: lives on disk, not in git
workspace/USER.md
workspace/MEMORY.md
workspace/DREAMS.md
workspace/memory/

# infra: root-level plumbing, applied by hand with sudo claw-install (runs infra/install.sh)
!infra/
!infra/**

# Python bytecode from infra test runs. Only under infra/: elsewhere (a skill folder) a planted .pyc
# could run in place of the reviewed .py, so claw-sync must see it and remove it.
/infra/**/__pycache__/
/infra/**/*.pyc
