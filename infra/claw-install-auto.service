[Unit]
Description=Install infra/ from origin/main when it changed (claw-install --auto)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/claw-install --auto
# success or failure to its own healthchecks check, from a root-only URL file (optional)
ExecStopPost=/usr/local/lib/claw/unit-ping %n /etc/claw/install.url
# waiting for a claw-sync run (up to 20 min) + install + claw-sync's deploy (20) + a gateway restart (5)
# + claw-smoke; claw-install's own limits say why first
TimeoutStartSec=90min
