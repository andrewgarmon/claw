#!/usr/bin/env bash
# claw-backup: snapshot the assistant's agent-owned state into the private claw-state repo.
# Runs as openclaw from a root-owned systemd timer (nightly).
# - packs USER.md, MEMORY.md, DREAMS.md and memory/** from the workspace (and the scheduled jobs, below) into one tar, encrypts it
#   with age to the public key in $AGE_RECIPIENTS (root-owned; the private key stays off the host)
#   and commits only the ciphertext, state.tar.gz.age, to a local git repo (~/.openclaw/state-backup,
#   ignored by the deployed repo, left alone by claw-sync). Without a key it fails (and fail-pings)
#   rather than back up plaintext.
# - scheduled jobs (OpenClaw automations, e.g. reminders) live in its state database, not in files:
#   each one's definition goes into the same tar as automations/<id>.json. If the export fails, the
#   rest is still backed up and pushed, then the run fails so the owner hears about it.
# - commits only when the state (or the key) changed: age output differs every run, so the check
#   is a hash of the plaintext tar and the key, kept in the local state dir, never in the repo
# - publishes through agent-git to branch agent/state/<host> on claw-state. agent-git pushes state
#   branches without a PR, so the history starts from this repo's own first commit.
# - every successful run, including "nothing new", touches ~/.cache/claw-backup/last-ok; claw-sync
#   fails its health ping when that's over 26h old (a backup timer that stopped running)
set -euo pipefail
export HOME=/home/openclaw
export PATH=$HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
WS=$HOME/.openclaw/workspace
REPO=$HOME/.openclaw/state-backup
ITEMS=(USER.md MEMORY.md DREAMS.md memory)
AGE_RECIPIENTS=/etc/claw/backup.age.pub   # one age1... public key per line; root-owned
host=$(hostname -s | tr -c 'A-Za-z0-9._\n-' '-')
BRANCH=agent/state/$host
STATE=$HOME/.cache/claw-backup; mkdir -p "$STATE"
exec 9>"$STATE/lock"; flock -n 9 || exit 0

# Any failure, including agent-git refusing a non-fast-forward push (state-backup lost or rebuilt),
# pings /fail on HEALTHCHECKS_PING_URL (the same check claw-sync pings) so it reaches the owner,
# not just the journal. claw-sync's next success ping marks the check up again.
fail_ping() {
  local hc
  hc=$(sed -n 's/^HEALTHCHECKS_PING_URL=//p' "$HOME/.openclaw/.env" 2>/dev/null | tail -n1 | tr -d "\"' \r")
  [ -n "$hc" ] || { echo "no HEALTHCHECKS_PING_URL; failure not reported" >&2; return 0; }
  curl -fsS -m 10 --retry 3 -o /dev/null --data-raw "$1" "$hc/fail" || echo "healthcheck ping failed" >&2
}
on_exit() {  # on_exit [exit status]
  local rc=${1:-$?}
  [ "$rc" != 0 ] || { touch "$STATE/last-ok"; return 0; }
  fail_ping "claw-backup failed on $host (exit $rc), backup not pushed: sudo journalctl -u claw-backup -n 20"
}
trap on_exit EXIT

[ -d "$WS" ] || { echo "no workspace at $WS" >&2; exit 1; }
command -v age >/dev/null || { echo "age isn't installed (sudo claw-install)" >&2; exit 1; }
grep -qE '^age1[0-9a-z]{58}$' "$AGE_RECIPIENTS" 2>/dev/null \
  || { echo "no age public key in $AGE_RECIPIENTS; nothing backed up (infra/README.md: state backup)" >&2; exit 1; }
gd() { git -C "$1" -c user.name=Assistant -c user.email=assistant@claw.invalid -c core.hooksPath=/dev/null "${@:2}"; }
g() { gd "$REPO" "$@"; }
if [ ! -d "$REPO/.git" ]; then
  # build in a scratch dir and move it into place, so a failed init is retried next run
  tmp=$REPO.new; rm -rf "$tmp"
  git init -q -b "$BRANCH" "$tmp"
  printf '# claw-state (%s)\n\nNightly snapshot of the assistant'"'"'s agent-owned state from %s:%s, written by infra/claw-backup: state.tar.gz.age, a gzipped tar encrypted with age (the private key is kept offline).\n' \
    "$host" "$host" "$WS" > "$tmp/README.md"
  gd "$tmp" add README.md
  gd "$tmp" commit -q -m "claw-state for $host"
  mv -T "$tmp" "$REPO"
fi
# the branch follows the current hostname, so after a move to a new name history continues there
g checkout -q -B "$BRANCH"

# export_jobs <dir>: every automation's definition, without its run state (next/last run, which
# changes every run and would make every night's backup differ), one file per job id
export_jobs() {
  local ids id
  mkdir -p "$1"
  ids=$(timeout 60 openclaw automations list --all --json | python3 -I -c '
import json, sys
d = json.load(sys.stdin)
jobs = d if isinstance(d, list) else d["jobs"]
print("\n".join(j["id"] for j in jobs))' 2>/dev/null) || return 1
  for id in $ids; do
    [[ $id =~ ^[A-Za-z0-9_-]{1,128}$ ]] || { echo "unexpected automation id" >&2; return 1; }
    timeout 60 openclaw automations get "$id" --json | python3 -I -c '
import json, sys
j = json.load(sys.stdin)
j.pop("state", None)
json.dump(j, sys.stdout, indent=2, sort_keys=True)' > "$1/$id.json" 2>/dev/null || return 1
  done
}

# Every commit adds the whole ciphertext to history that's never pruned (git can't delta or compress
# it), and GitHub refuses a file over 100 MB: compress first, and refuse a backup near that size.
MAX_BYTES=$((95 * 1024 * 1024))
OUT=state.tar.gz.age
# whatever is in the workspace now, as one tar with fixed metadata (same state -> same bytes)
work=$(mktemp -d); trap 'rc=$?; rm -rf "$work"; on_exit "$rc"' EXIT
present=(); for item in "${ITEMS[@]}"; do [ -e "$WS/$item" ] && present+=("$item"); done
jobs_ok=1
export_jobs "$work/automations" || { jobs_ok=""; echo "couldn't export the scheduled jobs; backing up the rest" >&2; }
# exit 1 is GNU tar's "a file changed while it was read" (the agent writing memory at 03:30): the
# archive is still complete, and tomorrow's run catches the change. Anything else is a failure.
trc=0
tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --format=gnu --exclude=.git --warning=no-file-changed \
  -cf "$work/state.tar" -C "$WS" "${present[@]}" -C "$work" automations || trc=$?
[ "$trc" -le 1 ] || { echo "tar failed (exit $trc)" >&2; exit 1; }
sum=$(cat "$work/state.tar" "$AGE_RECIPIENTS" | sha256sum | cut -d' ' -f1)
if [ "$sum" != "$(cat "$STATE/state-sum" 2>/dev/null)" ] || [ ! -e "$REPO/$OUT" ]; then
  gzip -n -9 < "$work/state.tar" > "$work/state.tar.gz"   # -n: no name or time, so same tar -> same gz
  age -R "$AGE_RECIPIENTS" -o "$REPO/$OUT.new" "$work/state.tar.gz"
  size=$(stat -c %s "$REPO/$OUT.new")
  if [ "$size" -gt "$MAX_BYTES" ]; then
    rm -f "$REPO/$OUT.new"
    echo "encrypted backup is $((size / 1024 / 1024)) MB, near GitHub's 100 MB file limit: nothing committed. Trim memory/ or split the backup." >&2
    exit 1
  fi
  mv -f "$REPO/$OUT.new" "$REPO/$OUT"
  # plaintext copies from before encryption leave the tree (older commits keep them)
  for item in "${ITEMS[@]}"; do rm -rf "${REPO:?}/$item"; done
  g add -A
  g commit -q -m "state backup $(date -I)"
  echo "$sum" > "$STATE/state-sum"
  echo "committed $(g rev-parse --short HEAD): $OUT ($(stat -c %s "$REPO/$OUT") bytes)"
fi

head=$(g rev-parse HEAD)
# a failed job export still pushes what was committed, then fails the run (and pings /fail)
jobs_done() { [ -n "$jobs_ok" ] || { echo "scheduled jobs weren't exported (see above)" >&2; exit 1; }; }
if [ "$BRANCH $head" = "$(cat "$STATE/pushed" 2>/dev/null)" ]; then echo "nothing new to push"; jobs_done; exit 0; fi
url=$(g bundle create -q - "$BRANCH" | sudo -n -u gitbot /usr/local/bin/agent-git pr claw-state "$BRANCH" "State backup: $host")
echo "$BRANCH $head" > "$STATE/pushed"
echo "pushed ${head:0:7} to $BRANCH: $url"
jobs_done
