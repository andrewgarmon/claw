#!/usr/bin/env bash
# redact-sync: mirror gitbot's redact.txt into the public repo's PERSONAL_DENYLIST Actions secret,
# so the CI "no personal words" check uses the same list agent-git checks public pushes against,
# and redact.txt is the only place to change it.
# Runs as root from a root-owned systemd timer (hourly). Installed root-owned to
# /usr/local/lib/claw/redact-sync. Its token is root-only (/etc/claw/redact-sync-token, 600: a
# fine-grained token for only the public repo, with only Secrets: read and write), so neither
# agent-git's token nor anything running as gitbot (which agent-git does for the agent and coder)
# can change the secret: the CI check stays an independent backstop to agent-git.
# - reads redact.txt as gitbot (root never opens a path in a service user's home), normalised exactly
#   as agent-git does (CRs and surrounding spaces stripped, blank lines and # comments dropped)
# - an empty or missing list is never pushed (an empty secret would switch the CI check off):
#   it fails instead, and the unit's unit-ping sends /fail to its own healthchecks.io check
# - entries are only ever added automatically. redact.txt is gitbot's file, so something running as
#   gitbot could swap it for a harmless list and quietly switch the check off. A list missing any entry
#   of the last upload (kept root-only in $STATE/list) is not uploaded and fails, until the owner
#   confirms with: sudo /usr/local/lib/claw/redact-sync --allow-removals
# - uploads when the list changed since the last upload (a hash in $STATE), and at least once a day
#   anyway, so a secret deleted or edited on GitHub (or a recreated repo) is put back
# - never prints or logs an entry: only counts (to the journal)
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C
OWNER=andrewgarmon
REPOS="claw"                                   # repos whose PERSONAL_DENYLIST mirrors redact.txt
REDACT_FILE=/home/gitbot/.config/redact.txt
TOKEN_FILE=/etc/claw/redact-sync-token
STATE=/var/lib/claw/redact-sync
export HOME=$STATE                             # gh's config dir: root-only, never a service home
umask 077

[ "$(id -u)" = 0 ] || { echo "redact-sync: run as root" >&2; exit 1; }
allow_removals=""; [ "${1:-}" = --allow-removals ] && allow_removals=1
fail() { echo "redact-sync: $*" >&2; exit 1; }

install -d -m 700 "$STATE"   # parents 755, the state dir itself 700
list=$(cd / && sudo -n -u gitbot cat "$REDACT_FILE" 2>/dev/null \
  | sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v -e '^$' -e '^#' || true)
[ -n "$list" ] || fail "redact.txt is empty or missing; secret left unchanged"
n=$(printf '%s\n' "$list" | wc -l)
hash=$(printf '%s\n%s\n' "$REPOS" "$list" | sha256sum | cut -d' ' -f1)
if [ -s "$STATE/list" ] && [ -z "$allow_removals" ]; then
  gone=$(comm -23 <(sort -u "$STATE/list") <(printf '%s\n' "$list" | sort -u) | wc -l)
  [ "$gone" = 0 ] || fail "redact.txt has lost $gone entries since the last upload; not uploading. If you removed them, run: sudo /usr/local/lib/claw/redact-sync --allow-removals"
fi
if [ "$hash" = "$(cat "$STATE/hash" 2>/dev/null)" ] && [ -n "$(find "$STATE/hash" -mmin -1440 2>/dev/null)" ]; then
  echo "redact-sync: unchanged ($n entries)"; exit 0
fi

[ -r "$TOKEN_FILE" ] && [ -s "$TOKEN_FILE" ] || fail "no token in $TOKEN_FILE (infra/README.md: CI secret from redact.txt)"
GH_TOKEN=$(head -n1 "$TOKEN_FILE"); export GH_TOKEN
for r in $REPOS; do
  printf '%s\n' "$list" | gh secret set PERSONAL_DENYLIST -R "$OWNER/$r" >/dev/null 2>&1 \
    || fail "gh secret set on $OWNER/$r failed (does $TOKEN_FILE have Secrets: read and write on it?)"
done
printf '%s\n' "$list" > "$STATE/list.new" && mv -f "$STATE/list.new" "$STATE/list"
echo "$hash" > "$STATE/hash.new" && mv -f "$STATE/hash.new" "$STATE/hash"
echo "redact-sync: updated PERSONAL_DENYLIST ($n entries) on $REPOS"
