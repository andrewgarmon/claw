#!/usr/bin/env bash
# claw-install: apply infra/ from a fresh, root-owned clone of origin/main.
#
# install.sh runs as root. Running it from /home/openclaw/.openclaw/infra/ would let the assistant's
# user (who can write that tree between claw-sync resets) change what root executes. So this
# bootstrap never runs anything from that checkout: it clones origin/main into a root-only
# temp dir, shows what changed in infra/ since the last install, asks, runs install.sh from
# the clone, records the commit and deletes the clone.
#
# Then it runs claw-sync, which deploys the commit (it holds back commits whose infra/ isn't installed)
# and restarts the gateway onto the new code, and runs claw-smoke. If the install, the deploy or the
# smoke test fails, it reinstalls the previous commit, sends claw-sync back to the commit it was on, and
# exits 1.
#
# --auto (claw-install-auto.timer, every 2 min): the same without asking, only when origin/main has
# moved. The gate is the owner's merge on GitHub: only main is installed, from GitHub, never from the
# agent-writable checkout, and nothing the agent's user runs can start this. A commit that failed is
# not retried until main moves (sudo claw-install retries it); until then every run fails, so its
# healthchecks check (unit-ping) stays down.
#
# Installed root-owned to /usr/local/sbin/claw-install (it updates itself from the clone after
# each install). First install: see infra/README.md ("Applying infra").
# Usage (as the admin user): sudo claw-install [-y]
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
REPO=https://github.com/andrewgarmon/claw.git
TOKEN_FILE=/home/coder/.config/coder.env
STATE=/var/lib/claw-install
WORK_BASE=/root
SELF=/usr/local/sbin/claw-install
SMOKE=/usr/local/bin/claw-smoke
OC_HOME=/home/openclaw                       # its ~/.openclaw and claw-sync's state (used as openclaw)

die() { echo "claw-install: $*" >&2; exit 1; }


# git as root: token from the env via a credential helper (never argv), no hooks, no prompts
export GIT_TERMINAL_PROMPT=0
GIT=(git -c credential.helper= -c 'credential.helper=!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
     -c core.hooksPath=/dev/null -c core.fsmonitor=)

read_token() {
  # coder's read-only token, if there is one (coder can write that file, so parse it, never source it).
  # The repo is public, so without one git clones anonymously.
  local t=
  if [ -f "$TOKEN_FILE" ] && [ ! -L "$TOKEN_FILE" ]; then
    t=$(sed -n 's/^GH_TOKEN=//p' "$TOKEN_FILE" | head -1)
  fi
  [ -n "$t" ] || return 0
  [[ "$t" =~ ^[A-Za-z0-9_]{20,255}$ ]] || die "the token in $TOKEN_FILE doesn't look like a GitHub token"
  GH_TOKEN=$t; export GH_TOKEN
}

page() { if command -v less >/dev/null; then less -R; else cat; fi; }

confirm() {  # confirm <repo> <sha> <last>: show what changed in infra/, ask y/n/d
  local r=$1 sha=$2 last=$3 ans
  echo "origin/main: $(git -C "$r" log -1 --format='%h %s (%cr)' "$sha")"
  if [ -z "$last" ]; then
    echo "no previous install recorded; installing all of infra/:"
    git -C "$r" ls-tree -r --name-only "$sha" -- infra/ backup.age.pub | sed 's/^/  /'
  elif [ "$last" = "$sha" ]; then
    echo "already installed at this commit (re-running is safe)"
  elif git -C "$r" cat-file -e "$last^{commit}" 2>/dev/null; then
    echo "infra/ (and backup.age.pub) changes since the last install (${last:0:7}):"
    git -C "$r" --no-pager log --format='  %h %s' "$last..$sha" -- infra/ backup.age.pub
    git -C "$r" --no-pager diff --stat "$last" "$sha" -- infra/ backup.age.pub | sed 's/^/  /'
    # commit subjects are written by agents; the diff is what root will run, so show all of it first
    if [ "$YES" != 1 ] && [ -t 0 ]; then
      git -C "$r" -c color.ui=always diff "$last" "$sha" -- infra/ backup.age.pub | page
    fi
  else
    echo "last installed commit ${last:0:7} isn't in origin/main's history (force push?); review all of infra/"
  fi
  [ "$YES" = 1 ] && return 0
  [ -t 0 ] || die "not a terminal: re-run with -y to install without asking"
  while :; do
    read -rp "Install ${sha:0:7}? [y]es / [n]o / [d]iff again: " ans
    case "$ans" in
      y|Y|yes) return 0 ;;
      d|D)
        if [ -n "$last" ] && [ "$last" != "$sha" ] && git -C "$r" cat-file -e "$last^{commit}" 2>/dev/null; then
          git -C "$r" -c color.ui=always diff "$last" "$sha" -- infra/ backup.age.pub | page
        else
          git -C "$r" -c color.ui=always show "$sha:infra/install.sh" | page
        fi ;;
      *) echo "not installed"; exit 1 ;;
    esac
  done
}

# claw-sync's state and checkout belong to the agent's user: used as openclaw, with timeouts (a file
# there could be a FIFO), and only to decide what to report or which commit to go back to.
oc() { (cd / && sudo -n -H -u openclaw timeout 30 "$@"); }
SYNC=$OC_HOME/.cache/claw-sync
sync_state() { oc head -c 40 "$SYNC/$1" 2>/dev/null || true; }
set_sync_state() { oc sh -c 'printf "%s\n" "$1" > "$2"' _ "$2" "$SYNC/$1"; }

# deploy <sha>: run claw-sync until it has deployed <sha> or a later commit (it restarts the gateway
# when infra/ changed). `systemctl start` on its oneshot returns when the run ends; a run already in
# progress may have started before the install was recorded, so try a few times.
deploy() {
  local g _
  for _ in 1 2 3; do
    systemctl start claw-sync.service || true
    g=$(sync_state good)
    if [ "$g" = "$1" ] || { [[ $g =~ ^[0-9a-f]{40}$ ]] && oc git -C "$OC_HOME/.openclaw" merge-base --is-ancestor "$1" "$g" 2>/dev/null; }; then
      echo "claw-sync deployed ${g:0:7}"; return 0
    fi
    [ "$(sync_state bad)" != "$1" ] || { echo "claw-sync rejected ${1:0:7} (its ping says why)" >&2; return 1; }
  done
  return 1
}

# openclaw itself, as the gateway's user, with its systemd --user session
oc_cli() { (cd / && sudo -n -H -u openclaw env XDG_RUNTIME_DIR="/run/user/$(id -u openclaw)" \
              PATH="$OC_HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin" openclaw "$@"); }
oc_version() { oc_cli --version 2>/dev/null | grep -oE '[0-9]{4}\.[0-9]+\.[0-9]+(-[0-9]+)?' | head -1; }

# update_openclaw <repo>: put the host on the OpenClaw version infra/openclaw/package.json pins, through
# OpenClaw's own updater (it stops, replaces and restarts the gateway, and recovers if the new one
# doesn't come up). Before the install is recorded, so config that needs the new version can't deploy
# first. Nothing pinned, or already that version: nothing to do.
update_openclaw() {
  local want have
  want=$(sed -n 's/^ *"openclaw": *"\([^"]*\)".*/\1/p' "$1/infra/openclaw/package.json" 2>/dev/null | head -1) || true
  [ -n "$want" ] || return 0
  [[ $want =~ ^[0-9]{4}\.[0-9]{1,3}\.[0-9]{1,3}(-[0-9]+)?$ ]] || { echo "infra/openclaw/package.json: \"$want\" isn't an exact OpenClaw version" >&2; return 1; }
  have=$(oc_version) || true
  [ "$have" != "$want" ] || return 0
  echo "updating OpenClaw ${have:-(unknown)} -> $want (openclaw update, as openclaw)"
  oc_cli update --tag "$want" --yes --timeout 900 || { echo "openclaw update to $want failed (it keeps or restores the previous version)" >&2; return 1; }
  have=$(oc_version) || true
  [ "$have" = "$want" ] || { echo "openclaw update finished, but openclaw --version says ${have:-nothing}, not $want" >&2; return 1; }
}

install_at() {  # install_at <repo> <sha>: install.sh and the pinned OpenClaw from that commit, then record it and update this bootstrap
  git -C "$1" checkout -q "$2"
  echo "running infra/install.sh from ${2:0:7}"
  # the clone stays private (its dir is 700); installed files get the usual sudo umask
  (umask 022; CLAW_INSTALL_SHA=$2 bash "$1/infra/install.sh") || return 1
  update_openclaw "$1" || return 1
  record "$2"
  # rename, so the running copy is never rewritten in place
  if ! cmp -s "$1/infra/claw-install" "$SELF"; then
    install -m 755 -o root -g root "$1/infra/claw-install" "$SELF.new" && mv -f "$SELF.new" "$SELF"
    echo "updated $SELF"
  fi
}

# 644: only a commit id, and claw-sync (as openclaw) reads it to hold back config that needs it
record() { printf '%s\n' "$1" > "$STATE/last.new" && chmod 644 "$STATE/last.new" && mv -f "$STATE/last.new" "$STATE/last"; }

# fail <repo> <sha> <prev> <was> <why>: put back the previous commit's infra/ and claw-sync's previous
# commit <was> (<sha> marked bad, so claw-sync doesn't deploy it again), mark <sha> failed, exit 1
fail() {
  local r=$1 sha=$2 prev=$3 was=$4
  echo "$sha" > "$STATE/failed"
  if [ -z "$prev" ] || [ "$prev" = "$sha" ]; then die "$5"; fi
  echo "claw-install: $5; rolling back to ${prev:0:7}" >&2
  install_at "$r" "$prev" || die "$5, and reinstalling ${prev:0:7} failed too: fix by hand"
  set_sync_state good "$was" && set_sync_state bad "$sha" || echo "couldn't reset claw-sync's state" >&2
  systemctl start claw-sync.service || true
  die "$5; rolled back to ${prev:0:7}. Retry with: sudo claw-install"
}

WORK=""
trap '[ -z "$WORK" ] || rm -rf "$WORK"' EXIT
trap 'exit 143' TERM INT HUP

main() {
  YES=0 AUTO=0
  case "${1:-}" in
    -y|--yes) YES=1 ;;
    --auto) YES=1 AUTO=1 ;;
    "") ;;
    *) echo "usage: sudo claw-install [-y]" >&2; exit 1 ;;
  esac
  [ "$(id -u)" = 0 ] || die "run with sudo"
  read_token
  install -d -m 755 -o root -g root "$STATE"
  exec 8>"$STATE/lock"
  if [ "$AUTO" = 1 ]; then
    flock -n 8 || exit 0
  elif ! flock -n 8; then
    echo "another claw-install is running (the auto-install?); waiting for it"
    flock -w 5400 8 || die "still running after 90 minutes"
  fi

  local r sha last="" was
  if [ -f "$STATE/last" ]; then
    last=$(head -c 40 "$STATE/last")
    [[ "$last" =~ ^[0-9a-f]{40}$ ]] || last=
  fi
  if [ "$AUTO" = 1 ]; then
    sha=$("${GIT[@]}" ls-remote "$REPO" refs/heads/main 2>/dev/null | cut -f1) || true
    [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "couldn't read origin/main (offline?); next run tries again"; exit 0; }
    [ "$sha" != "$last" ] || exit 0
    [ "$sha" != "$(head -c 40 "$STATE/failed" 2>/dev/null)" ] \
      || die "${sha:0:7} failed and was rolled back (journalctl -u claw-install-auto); waiting for a new merge, or run: sudo claw-install"
  fi

  WORK=$(mktemp -d "$WORK_BASE/claw-install.XXXXXX")
  chmod 700 "$WORK"
  r=$WORK/repo
  "${GIT[@]}" clone -q --no-tags --single-branch --branch main "$REPO" "$r" \
    || die "clone of $REPO failed (a private repo needs a read-only token in $TOKEN_FILE)"
  sha=$(git -C "$r" rev-parse HEAD)
  if [ "$AUTO" = 1 ] && [ -n "$last" ] && git -C "$r" merge-base --is-ancestor "$last" "$sha" 2>/dev/null \
     && git -C "$r" diff --quiet "$last" "$sha" -- infra/ backup.age.pub; then
    record "$sha"; exit 0   # nothing to install: just move the marker claw-sync compares against
  fi

  confirm "$r" "$sha" "$last"
  [ "$(git -C "$r" cat-file -t "$last" 2>/dev/null)" = commit ] || last=""   # not on main (force push?): nothing to go back to
  # where claw-sync goes back to on failure: the commit it's on, if that's on main before <sha> (its
  # checkout is agent-writable, so checked against the root clone), else the previous install
  was=$(oc git -C "$OC_HOME/.openclaw" rev-parse -q --verify HEAD 2>/dev/null) || was=
  [[ $was =~ ^[0-9a-f]{40}$ ]] && [ "$was" != "$sha" ] && git -C "$r" merge-base --is-ancestor "$was" "$sha" 2>/dev/null || was=$last

  install_at "$r" "$sha" || fail "$r" "$sha" "$last" "$was" "installing ${sha:0:7} failed"
  echo "installed ${sha:0:7}"
  [ "$(sync_state bad)" != "$sha" ] || oc rm -f "$SYNC/bad"   # retrying a rolled-back commit
  if ! deploy "$sha"; then
    # main moved on to a commit with infra/ changes of its own: claw-sync waits for that install
    now=$("${GIT[@]}" ls-remote "$REPO" refs/heads/main 2>/dev/null | cut -f1) || now=
    if [[ $now =~ ^[0-9a-f]{40}$ ]] && [ "$now" != "$sha" ]; then
      rm -f "$STATE/failed"
      echo "origin/main moved on to ${now:0:7} during the install; the next install covers it"; return 0
    fi
    fail "$r" "$sha" "$last" "$was" "claw-sync didn't deploy ${sha:0:7} (journalctl -u claw-sync -n 30)"
  fi
  if [ -x "$SMOKE" ]; then
    echo "running claw-smoke"
    "$SMOKE" || fail "$r" "$sha" "$last" "$was" "installed ${sha:0:7}, but the smoke test FAILED (see above)"
    echo "installed ${sha:0:7}; smoke test passed"
  fi
  rm -f "$STATE/failed"
}

main "$@"
