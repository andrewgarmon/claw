#!/usr/bin/env bash
# coder-sandbox-probe: run by `coder-acp-sandbox --check`, as coder inside the sandbox. Checks that
# what should be writable is and what shouldn't be isn't, without changing anything: a file is opened
# for appending and nothing written; a directory gets a new empty file, removed at once.
# Prints one line per path; exit 1 if any is wrong.
set -uo pipefail
H=/home/coder
bad=0
can_write() {
  if [ -d "$1" ]; then local f; f=$(mktemp -p "$1" .probe.XXXXXX 2>/dev/null) && rm -f "$f"
  else ( : >> "$1" ) 2>/dev/null; fi
}
want() {  # want writable|read-only <path>
  local got=read-only
  if can_write "$2"; then got=writable; fi
  if [ "$got" = "$1" ]; then echo "ok   $2 is $got"; else echo "BAD  $2 is $got"; bad=1; fi
}
# rw_mount <path>: mounted read-write in here (for paths coder can't write anyway, like gitbot's home)
rw_mount() {
  if awk -v p="$1" '$5 == p { split($6, o, ","); if (o[1] == "rw") f = 1 } END { exit !f }' /proc/self/mountinfo
  then echo "ok   $1 is mounted read-write"; else echo "BAD  $1 isn't mounted read-write"; bad=1; fi
}
want writable /srv/work
want writable "$H/.claude"
for p in .cache .npm; do [ ! -d "$H/$p" ] || want writable "$H/$p"; done
rw_mount /home/gitbot   # agent-git, as gitbot through sudo, keeps its repos and log there
for p in settings.json settings.local.json CLAUDE.md rules commands agents skills output-styles plugins; do
  want read-only "$H/.claude/$p"
done
want read-only "$H"
want read-only "$H/.claude.json"
want read-only /etc
want read-only /usr/local/bin
# its own PID namespace: no other process's /proc/<pid>/root (the host's view) in reach
if [ "$(cat /proc/1/comm 2>/dev/null)" != systemd ] && [ "$(ls -d /proc/[0-9]* | wc -l)" -lt 50 ]; then
  echo "ok   own PID namespace"; else echo "BAD  host processes are visible"; bad=1; fi
# agent-git runs through sudo, which no_new_privs would stop
if grep -q '^NoNewPrivs:[[:space:]]*0$' /proc/self/status; then echo "ok   sudo can work (no_new_privs off)"
else echo "BAD  no_new_privs is on: sudo -u gitbot agent-git can't work"; bad=1; fi
exit "$bad"
